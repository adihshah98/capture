# Copy to .env and fill in. Real environment variables take precedence.
# .env is gitignored — never commit a key.

# Required for the "Analyze with AI" button to appear at all.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides.
# GEMINI_MODEL=gemini-2.5-flash
# Page reconstruction timeout (seconds). Raise for long, highly active sessions.
# ANALYZE_TIMEOUT_S=600
# Frames sampled per second of activity; idle stretches are skipped either way.
# Clamped to 0.2–4 — outside that, one session becomes thousands of images.
# ANALYZE_FPS=1
# Cap on frames sent to the model, applied by default. 0 leaves it uncapped,
# which lets a continuously-active session grow a frame per second without
# bound. For ~5 min active sessions on a small box, 60–120 keeps
# Chromium/Gemini bounded.
# ANALYZE_MAX_FRAMES=90
# Cohort write-ups use the Gemini Batch API (≈50% cheaper). Set 0 for sync.
# ANALYZE_BATCH=1
# ANALYZE_BATCH_POLL_S=15
# Backstop for a batch that never reaches a terminal state. Hitting it does not
# fail the cohort: the job name stays on disk and a restart resumes it, rather
# than re-running the sessions and paying twice. 0 waits forever.
# ANALYZE_BATCH_MAX_WAIT_S=86400
# Consecutive failed polls tolerated before we stop watching (and resume later).
# ANALYZE_BATCH_POLL_MAX_ERRORS=5

# Local development only — serves the replay UI without a login.
# REPLAY_AUTH_DISABLED=1
